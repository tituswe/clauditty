<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
   <Package Name="Titty" UpgradeCode="42b91277-0892-4fe2-836a-2db44fb9b2b5" Language="1033" Codepage="1252" Version="0.18.0-dev" Manufacturer="Titty" InstallerVersion="200">
      <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
      <Icon Id="TittyIco" SourceFile=".\alacritty\windows\titty.ico" />
      <WixVariable Id="WixUILicenseRtf" Value=".\alacritty\windows\wix\license.rtf" />
      <Property Id="ARPPRODUCTICON" Value="TittyIco" />
      <MediaTemplate EmbedCab="yes" />
      <ui:WixUI Id="WixUI_Minimal" />
      <Feature Id="ProductFeature" Title="ConsoleApp" Level="1">
         <ComponentRef Id="TittyExe" />
         <ComponentRef Id="TittyShortcut" />
         <ComponentRef Id="ModifyPathEnv" />
         <ComponentRef Id="ContextMenu" />
         <ComponentRef Id="ContextMenuFolder" />
      </Feature>
      <!-- Application binaries -->
      <DirectoryRef Id="TittyProgramFiles">
         <Component Id="TittyExe">
            <File Id="TittyExeFile" Source=".\target\release\titty.exe" Name="titty.exe" KeyPath="yes" />
         </Component>
      </DirectoryRef>
      <DirectoryRef Id="TittyProgramMenu">
         <!-- Application shortcut -->
         <Component Id="TittyShortcut" Guid="c3fdf291-c3df-4df5-8369-bfab37d99fb4">
            <Shortcut Id="TittyShortcutFile" Name="Titty" Description="A cross-platform, GPU-accelerated terminal emulator" Target="[TittyProgramFiles]titty.exe" />
            <RemoveFolder Id="TittyProgramMenu" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Titty" Name="installed" Type="integer" Value="1" KeyPath="yes" />
         </Component>
      </DirectoryRef>
      <DirectoryRef Id="TittyProgramFiles">
         <!-- Add to PATH -->
         <Component Id="ModifyPathEnv" Guid="edf0b679-9eb6-46f7-a5d1-5160f30acb34" KeyPath="yes">
            <Environment Id="PathEnv" Value="[TittyProgramFiles]" Name="PATH" Permanent="no" Part="first" Action="set" System="yes" />
         </Component>
      </DirectoryRef>
      <StandardDirectory Id="ProgramFiles64Folder">
         <Directory Id="TittyProgramFiles" Name="Titty" />
      </StandardDirectory>
      <StandardDirectory Id="ProgramMenuFolder">
         <Directory Id="TittyProgramMenu" Name="Titty" />
      </StandardDirectory>
      <!-- Add context menu -->
      <Component Id="ContextMenu" Guid="449f9121-f7b9-41fe-82da-52349ea8ff91" Directory="TARGETDIR">
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Open Titty here\command">
            <RegistryValue Type="string" Value='[TittyProgramFiles]titty.exe --working-directory "%v"' KeyPath="yes" />
         </RegistryKey>
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Open Titty here">
            <RegistryValue Type="string" Name="Icon" Value="[TittyProgramFiles]titty.exe" />
         </RegistryKey>
      </Component>
      <Component Id="ContextMenuFolder" Guid="69483b38-a267-433f-9395-60827963347a" Directory="TARGETDIR">
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Open Titty here\command">
            <RegistryValue Type="string" Value='[TittyProgramFiles]titty.exe --working-directory "%v"' KeyPath="yes" />
         </RegistryKey>
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Open Titty here">
            <RegistryValue Type="string" Name="Icon" Value="[TittyProgramFiles]titty.exe" />
         </RegistryKey>
      </Component>
   </Package>
</Wix>
