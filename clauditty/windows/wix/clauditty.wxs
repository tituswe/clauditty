<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
   <Package Name="Clauditty" UpgradeCode="42b91277-0892-4fe2-836a-2db44fb9b2b5" Language="1033" Codepage="1252" Version="0.18.0-dev" Manufacturer="Clauditty" InstallerVersion="200">
      <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
      <Icon Id="ClaudittyIco" SourceFile=".\clauditty\windows\clauditty.ico" />
      <WixVariable Id="WixUILicenseRtf" Value=".\clauditty\windows\wix\license.rtf" />
      <Property Id="ARPPRODUCTICON" Value="ClaudittyIco" />
      <MediaTemplate EmbedCab="yes" />
      <ui:WixUI Id="WixUI_Minimal" />
      <Feature Id="ProductFeature" Title="ConsoleApp" Level="1">
         <ComponentRef Id="ClaudittyExe" />
         <ComponentRef Id="ClaudittyShortcut" />
         <ComponentRef Id="ModifyPathEnv" />
         <ComponentRef Id="ContextMenu" />
         <ComponentRef Id="ContextMenuFolder" />
      </Feature>
      <!-- Application binaries -->
      <DirectoryRef Id="ClaudittyProgramFiles">
         <Component Id="ClaudittyExe">
            <File Id="ClaudittyExeFile" Source=".\target\release\clauditty.exe" Name="clauditty.exe" KeyPath="yes" />
         </Component>
      </DirectoryRef>
      <DirectoryRef Id="ClaudittyProgramMenu">
         <!-- Application shortcut -->
         <Component Id="ClaudittyShortcut" Guid="c3fdf291-c3df-4df5-8369-bfab37d99fb4">
            <Shortcut Id="ClaudittyShortcutFile" Name="Clauditty" Description="A cross-platform, GPU-accelerated terminal emulator" Target="[ClaudittyProgramFiles]clauditty.exe" />
            <RemoveFolder Id="ClaudittyProgramMenu" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Clauditty" Name="installed" Type="integer" Value="1" KeyPath="yes" />
         </Component>
      </DirectoryRef>
      <DirectoryRef Id="ClaudittyProgramFiles">
         <!-- Add to PATH -->
         <Component Id="ModifyPathEnv" Guid="edf0b679-9eb6-46f7-a5d1-5160f30acb34" KeyPath="yes">
            <Environment Id="PathEnv" Value="[ClaudittyProgramFiles]" Name="PATH" Permanent="no" Part="first" Action="set" System="yes" />
         </Component>
      </DirectoryRef>
      <StandardDirectory Id="ProgramFiles64Folder">
         <Directory Id="ClaudittyProgramFiles" Name="Clauditty" />
      </StandardDirectory>
      <StandardDirectory Id="ProgramMenuFolder">
         <Directory Id="ClaudittyProgramMenu" Name="Clauditty" />
      </StandardDirectory>
      <!-- Add context menu -->
      <Component Id="ContextMenu" Guid="449f9121-f7b9-41fe-82da-52349ea8ff91" Directory="TARGETDIR">
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Open Clauditty here\command">
            <RegistryValue Type="string" Value='[ClaudittyProgramFiles]clauditty.exe --working-directory "%v"' KeyPath="yes" />
         </RegistryKey>
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Open Clauditty here">
            <RegistryValue Type="string" Name="Icon" Value="[ClaudittyProgramFiles]clauditty.exe" />
         </RegistryKey>
      </Component>
      <Component Id="ContextMenuFolder" Guid="69483b38-a267-433f-9395-60827963347a" Directory="TARGETDIR">
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Open Clauditty here\command">
            <RegistryValue Type="string" Value='[ClaudittyProgramFiles]clauditty.exe --working-directory "%v"' KeyPath="yes" />
         </RegistryKey>
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Open Clauditty here">
            <RegistryValue Type="string" Name="Icon" Value="[ClaudittyProgramFiles]clauditty.exe" />
         </RegistryKey>
      </Component>
   </Package>
</Wix>
